{
  "source": {
    "include": [],
    "exclude": [
      "tests/**",
      "test/**",
      "spec/**",
      "features/**",
      "e2e/**",
      "qa/**",
      "**/tests/**",
      "**/test/**",
      "**/spec/**",
      "**/__tests__/**",
      "**/*_test.*",
      "**/test_*.*",
      "test.*",
      "**/test.*",
      "test-d.*",
      "**/test-d.*",
      "**/*.test-d.*",
      "**/*.test.*",
      "**/*.spec.*",
      "**/*.config.*"
    ],
    "extensions": [".py", ".pyi", ".ts", ".tsx", ".js", ".mjs", ".cjs", ".lua"]
  },
  "test": {
    "command": ["make", "test"],
    "timeout_seconds": 600
  },
  "format_lint": {
    "enabled": true,
    "required": true,
    "commands": [
      [".venv/bin/python", "-m", "ruff", "check", "voicebridge.py", "voicebridge", "tests", ".quality/dependency_edges.py"],
      ["luacheck", "voicebridge.lua", "voicebridge_lua", "tests/lua"],
      ["npm", "--prefix", "raycast", "run", "lint:eslint"],
      ["raycast/node_modules/.bin/prettier", "--check", "raycast/src"]
    ],
    "timeout_seconds": 300
  },
  "types": {
    "enabled": true,
    "required": true,
    "commands": [
      [".venv/bin/python", "-m", "mypy"],
      ["npm", "--prefix", "raycast", "run", "typecheck"]
    ],
    "timeout_seconds": 600
  },
  "contracts": {
    "enabled": true,
    "required": true,
    "commands": [
      [".venv/bin/python", "-m", "pytest", "-q", "tests/test_contract.py"]
    ],
    "patterns": [
      "**/openapi.json",
      "**/openapi.yaml",
      "**/openapi.yml",
      "**/*.schema.json",
      "**/schemas/*.json"
    ],
    "timeout_seconds": 300
  },
  "metrics": {
    "command": null,
    "report": null,
    "coverage_commands": [
      ["mkdir", "-p", ".quality/coverage/python", ".quality/coverage/lua"],
      [".venv/bin/python", "-m", "coverage", "erase"],
      [".venv/bin/python", "-m", "coverage", "run", "--branch", "-m", "pytest", "-q"],
      [".venv/bin/python", "-m", "coverage", "lcov", "-o", "{root}/.quality/coverage/python/lcov.info"],
      ["raycast/node_modules/.bin/vitest", "run", "--root", "raycast", "--coverage", "--coverage.reporter=lcov", "--coverage.reportsDirectory={root}/.quality/coverage/raycast"],
      ["env", "VB_LUA_TEST=1", "lua", "-lluacov", "tests/lua/test_helpers.lua"],
      ["luacov", "-r", "lcov"],
      ["python3", "/Users/benreich/.claude/skills/code-discipline/scripts/repo_quality_gate.py", "--merge-lcov", "{root}/.quality/coverage/lcov.info", "={root}/.quality/coverage/python/lcov.info", "raycast={root}/.quality/coverage/raycast/lcov.info", "={root}/.quality/coverage/lua/lcov.info"]
    ],
    "coverage_report": ".quality/coverage/lcov.info",
    "coverage_format": "lcov",
    "timeout_seconds": 600
  },
  "mutation": {
    "enabled": false,
    "engine": "auto",
    "incremental": true,
    "test_command": ["make", "test"],
    "test_files": [],
    "vitest_config": "raycast/vitest.config.ts",
    "vitest_dir": "raycast",
    "vitest_related": true,
    "timeout_seconds": 600,
    "max_mutants": 0,
    "workers": "auto",
    "operators": {
      "==": "!=",
      "!=": "==",
      "<=": ">",
      ">=": "<",
      "<": ">",
      ">": "<",
      "+": "-",
      "-": "+"
    },
    "exclude": []
  },
  "dead_code": {
    "enabled": true,
    "required": true,
    "commands": [
      [".venv/bin/python", "-m", "vulture"],
      ["raycast/node_modules/.bin/knip", "--directory", "raycast", "--no-progress"]
    ],
    "timeout_seconds": 300
  },
  "smoke": {
    "enabled": true,
    "commands": [
      [
        "python3", "/Users/benreich/.claude/skills/code-discipline/scripts/smoke_check.py",
        "--start", ".venv/bin/python voicebridge.py serve --port \"$PORT\"",
        "--path", "/",
        "--env", "HOME={root}/.quality/smoke-home",
        "--env", "HF_HUB_OFFLINE=1",
        "--timeout", "120"
      ]
    ],
    "timeout_seconds": 300
  },
  "flaky_tests": {
    "enabled": false,
    "timeout_seconds": 600
  },
  "dependencies": {
    "command": [
      "python3",
      ".quality/dependency_edges.py",
      "--root",
      "{root}",
      "--out",
      "{report}"
    ],
    "edges_report": "{report}",
    "rules": ".quality/quality-dependencies.json",
    "timeout_seconds": 300
  },
  "tools": {
    "auto_install": false,
    "cache_dir": null
  }
}

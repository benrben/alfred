# Python
.venv/
__pycache__/
*.py[cod]

# Local config written by the installer / front-end (the tracked file is
# config.example.toml; a real config.toml next to the script is yours).
config.toml
*.bak

# Test / tool caches (don't depend on a tool's courtesy self-ignore file)
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# macOS
.DS_Store

# Quality gate outputs (the .quality/*.json configuration is tracked)
.quality/coverage/
.quality/quality-gate-state.json
.quality/quality-gate-report.html
.quality/smoke-home/

# Project-local skill installs (a stale/duplicate code-discipline copy; the
# canonical one this repo's gate uses is ~/.claude/skills/code-discipline).
.agents/
.claude/
